---
import Base from '../../layouts/Base.astro';
import Home from '../../components/marketing/Home.astro';
import { frontmatter as content } from '../../content/pages/tr/home.md';
import { homeFacts } from '../../lib/home.ts';

// The pin facts are read at build time; a missing fact fails the build with the message of scripts/lib/pin-facts.mjs.
const facts = homeFacts();
---

<Base path="/tr/" title={{ kind: 'home' }} lead={content.lead} source={{ kind: 'site', translatedFrom: content.translatedFrom }}>
  <Home lang="tr" content={content} facts={facts} />
</Base>
