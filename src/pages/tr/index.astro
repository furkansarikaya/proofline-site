---
import Base from '../../layouts/Base.astro';
import CommandBlock from '../../components/marketing/CommandBlock.astro';

const lead = 'Bu bir yer tutucu sayfadır; içerik sonraki bir görevde gelecek.';
---

<Base path="/tr/" title={{ kind: 'home' }} lead={lead}>
  <div class="wrap">
    <h1>Proofline</h1>
    <p>{lead}</p>
    <CommandBlock lang="tr" label="Claude Code" lines={['/plugin marketplace add furkansarikaya/proofline', '/plugin install proofline@proofline']} />
  </div>
</Base>
