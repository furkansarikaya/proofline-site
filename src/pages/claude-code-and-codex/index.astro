---
import Base from '../../layouts/Base.astro';
import AgentsPage from '../../components/marketing/AgentsPage.astro';
import { frontmatter } from '../../content/pages/en/claude-code-and-codex.md';
import { agentsFacts, readAgentsContent } from '../../lib/agents.ts';

// The pin facts are read at build time; a missing README sentence fails the build naming this page and the pattern (src/lib/agents.ts).
const facts = agentsFacts('/claude-code-and-codex/');
const content = readAgentsContent(frontmatter, 'en');
---

<Base path="/claude-code-and-codex/" title={{ kind: 'site', text: content.title }} lead={content.lead}>
  <AgentsPage lang="en" content={content} facts={facts} />
</Base>
