---
import Base from '../layouts/Base.astro';
import CommandBlock from '../components/marketing/CommandBlock.astro';

const lead = 'This is a placeholder page; the content arrives in a later task.';
---

<Base path="/" title={{ kind: 'home' }} lead={lead}>
  <div class="wrap">
    <h1>Proofline</h1>
    <p>{lead}</p>
    <CommandBlock lang="en" label="Claude Code" lines={['/plugin marketplace add furkansarikaya/proofline', '/plugin install proofline@proofline']} />
  </div>
</Base>
