---
import Base from '../layouts/Base.astro';
import Home from '../components/marketing/Home.astro';
import { frontmatter as content } from '../content/pages/en/home.md';
import { homeFacts } from '../lib/home.ts';

// The pin facts are read at build time; a missing fact fails the build with the message of scripts/lib/pin-facts.mjs.
const facts = homeFacts();
---

<Base path="/" title={{ kind: 'home' }} lead={content.lead}>
  <Home lang="en" content={content} facts={facts} />
</Base>
