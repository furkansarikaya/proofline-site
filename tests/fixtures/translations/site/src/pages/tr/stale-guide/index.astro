---
// A Turkish guide whose recorded blob id differs from the blob id of its English file: the build warns naming this page and still exits 0.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../../../../../../../../src/layouts/Base.astro';
import { blobId } from '../../../../../../../../scripts/lib/lock.mjs';

const guides = join(process.cwd(), 'tests', 'fixtures', 'translations', 'guides');
const recordedBlob = /blob:\s*([0-9a-f]{40})/.exec(readFileSync(join(guides, 'tr-stale.md'), 'utf8'))?.[1] ?? '';
const englishBlob = blobId(readFileSync(join(guides, 'en.md')));
---

<Base path="/tr/stale-guide/" title={{ kind: 'site', text: 'Eski kılavuz' }} lead="Güncel olmayan bir çevirinin fixture sayfası." source={{ kind: 'guide', recordedBlob, englishBlob }}>
  <h1>Eski kılavuz</h1>
</Base>
