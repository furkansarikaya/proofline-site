{
  "name": "proofline-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node scripts/sync.mjs fetch && astro build && node scripts/check-dist.mjs guards dist",
    "sync": "node scripts/sync.mjs fetch",
    "sync:lock": "node scripts/sync.mjs lock",
    "translation:stamp": "node scripts/translation-stamp.mjs",
    "test": "node --test",
    "check:determinism": "node scripts/check-dist.mjs determinism",
    "check:links": "node scripts/check-dist.mjs links dist",
    "check:guards": "node scripts/check-dist.mjs guards dist",
    "test:axe": "node --test tests/axe.mjs",
    "test:controls": "node --test tests/controls.mjs",
    "test:browser": "node --test tests/browser/*.mjs",
    "check:workflows": "node scripts/check-workflows.mjs"
  },
  "dependencies": {
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "cheerio": "1.2.0",
    "playwright": "1.65.1",
    "yaml": "2.9.1"
  }
}
